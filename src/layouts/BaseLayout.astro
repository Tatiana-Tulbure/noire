---
import "../styles/global.css";
import "../styles/commerce.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import CartDrawer from "../components/CartDrawer.astro";
import { clientCatalog } from "../data/products";

interface Props {
  title: string;
  description: string;
  image?: string;
  /** Highlighted main-nav item */
  active?: string;
  /** Hide the footer (unused today, kept for checkout-style pages) */
  footer?: boolean;
}

const { title, description, image = "/assets/images/og-home.jpg", active, footer = true } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL(image, Astro.site).href : image;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="format-detection" content="telephone=no, address=no" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Concept project: keep it out of search results -->
    <meta name="robots" content="noindex, nofollow" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#02060f" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="NOIRÉ" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;700&family=Raleway:wght@400;500;600&display=swap"
    />
    <slot name="head" />
  </head>
  <body>
    <a class="sr-only" href="#main">Skip to content</a>
    <Navbar active={active} />
    <main id="main">
      <slot />
    </main>
    {footer && <Footer />}
    <CartDrawer />
    <script id="noire-catalog" type="application/json" set:html={JSON.stringify(clientCatalog)} />
    <script>
      import "../scripts/ui.ts";
    </script>
  </body>
</html>
