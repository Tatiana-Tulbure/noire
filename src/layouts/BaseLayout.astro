---
import "../styles/global.css";
import "../styles/commerce.css";
import "../styles/motion.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import CartDrawer from "../components/CartDrawer.astro";
import QuickView from "../components/QuickView.astro";
import { clientCatalog } from "../data/products";

interface Props {
  title: string;
  description: string;
  image?: string;
  /** Highlighted main-nav item */
  active?: string;
  /** Hide the footer (unused today, kept for checkout-style pages) */
  footer?: boolean;
}

const { title, description, image = "/assets/images/og-home.jpg", active, footer = true } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL(image, Astro.site).href : image;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="format-detection" content="telephone=no, address=no" />
    <script is:inline>
      // Motion is opt-out: skip it for reduced-motion users. The intro plays once per session.
      (function () {
        var d = document.documentElement;
        try {
          if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
          d.classList.add("motion");
          if (!sessionStorage.getItem("noire:intro")) d.classList.add("has-intro");
        } catch (e) {}
        // Safety net: never leave content hidden if the motion script fails to load
        setTimeout(function () { d.classList.add("motion-ready", "intro-done"); }, 4500);
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Concept project: keep it out of search results -->
    <meta name="robots" content="noindex, nofollow" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#02060f" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="NOIRÉ" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;700&family=Raleway:wght@400;500;600&display=swap"
    />
    <slot name="head" />
  </head>
  <body>
    <div class="intro" aria-hidden="true">
      <span class="intro__word">
        {["N", "O", "I", "R", "É"].map((c) => <span class="intro__mask"><span class="intro__char">{c}</span></span>)}
      </span>
      <span class="intro__line"></span>
    </div>
    <div class="progress" data-progress aria-hidden="true"></div>
    <a class="sr-only" href="#main">Skip to content</a>
    <Navbar active={active} />
    <main id="main">
      <slot />
    </main>
    {footer && <Footer />}
    <CartDrawer />
    <QuickView />
    <script id="noire-catalog" type="application/json" set:html={JSON.stringify(clientCatalog)} />
    <script>
      import "../scripts/ui.ts";
      import "../scripts/motion.ts";
    </script>
  </body>
</html>
