---
import BaseLayout from "../layouts/BaseLayout.astro";
import AuthShell from "../components/AuthShell.astro";
import Field from "../components/Field.astro";
import { CONCEPT_NOTE, CONCEPT_CONFIRM } from "../data/concept";
---

<BaseLayout title="Create new password — NOIRÉ" description="Reset your NOIRÉ account password.">
  <AuthShell title="Create new password">
    <p class="text-body" slot="lead">Forgot your password? Enter your email to receive a reset link.</p>
    <form class="reset" data-demo-form>
      <Field label="Email" name="email" type="email" placeholder="Enter your email" autocomplete="email" required hint={CONCEPT_NOTE} />
      <button class="btn btn--light" type="submit"><span>SEND INSTRUCTIONS</span></button>
      <p class="demo-confirm" role="status" data-demo-confirm hidden>{CONCEPT_CONFIRM}</p>
    </form>
  </AuthShell>
</BaseLayout>

<style>
  .reset {
    display: flex;
    flex-direction: column;
    gap: 0.75em;
  }

  .reset .btn {
    margin-top: 0.75em;
  }
</style>
