---
import BaseLayout from "../layouts/BaseLayout.astro";
import AuthShell from "../components/AuthShell.astro";
import Field from "../components/Field.astro";
---

<BaseLayout title="Create new password — NOIRÉ" description="Reset your NOIRÉ account password.">
  <AuthShell title="Create new password">
    <p class="text-body" slot="lead">Forgot your password? Enter your email to receive a reset link.</p>
    <form class="reset" data-demo-form>
      <Field label="Email" name="email" type="email" placeholder="Enter your email" autocomplete="email" required />
      <button class="btn btn--light" type="submit"><span>SEND INSTRUCTIONS</span></button>
      <p class="reset__sent text-body" role="status" hidden>If an account exists for this email, a reset link is on its way.</p>
    </form>
  </AuthShell>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>(".reset");
  form?.addEventListener("demo:valid", () => {
    form.querySelector<HTMLElement>(".reset__sent")!.hidden = false;
  });
</script>

<style>
  .reset {
    display: flex;
    flex-direction: column;
    gap: 0.75em;
  }

  .reset .btn {
    margin-top: 0.75em;
  }

  .reset__sent {
    color: var(--color-accent);
  }
</style>
