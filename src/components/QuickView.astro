---
import Icon from "./Icon.astro";
---

<!-- Quick view: filled from the client catalog by ui.ts. The native dialog element gives Esc + focus handling for free. -->
<dialog class="qv" id="quick-view" aria-labelledby="qv-title" data-fly-scope>
  <div class="qv__panel">
    <button class="qv__close" type="button" data-qv-close aria-label="Close quick view">
      <Icon name="close" />
    </button>
    <div class="qv__media">
      <div class="qv__glow" data-qv-glow aria-hidden="true"></div>
      <img class="qv__img" src="" alt="" data-qv-img data-fly-img />
    </div>
    <div class="qv__info">
      <h2 class="title-lg qv__title" id="qv-title" data-qv-name></h2>
      <p class="qv__price" data-qv-price></p>
      <p class="text-body" data-qv-text></p>
      <fieldset class="qv__colors" data-qv-colors hidden>
        <legend class="text-label">Color: <span data-qv-color-name></span></legend>
        <div class="qv__swatches" data-qv-swatches></div>
      </fieldset>
      <div class="qv__actions">
        <button class="btn btn--light" type="button" data-add-to-cart data-qv-add><span>Add to cart</span></button>
        <a class="qv__more" href="#" data-qv-link>View details</a>
      </div>
    </div>
  </div>
</dialog>

<style>
  .qv {
    margin: auto;
    width: min(75em, calc(100vw - 2 * var(--container-padding)));
    max-height: calc(100vh - 4em);
    padding: 0;
    border: 1px solid var(--color-border);
    background-color: var(--color-surface);
    color: var(--color-text);
    overflow: auto;
  }

  .qv::backdrop {
    background-color: rgba(2, 6, 15, 0.72);
    backdrop-filter: blur(6px);
  }

  .qv__panel {
    position: relative;
    display: grid;
    grid-template-columns: 1.1fr 1fr;
  }

  .qv__close {
    position: absolute;
    top: 1em;
    right: 1em;
    z-index: 2;
    display: grid;
    place-items: center;
    min-width: 2.75em;
    min-height: 2.75em;
  }

  .qv__media {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 36em;
    background-color: var(--color-bg);
    overflow: hidden;
  }

  .qv__glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(45% 45% at 50% 58%, currentColor 0%, transparent 100%);
    color: var(--color-accent);
    opacity: 0.16;
    transition: color 0.8s ease;
  }

  .qv__img {
    position: relative;
    width: 85%;
    height: 30em;
    object-fit: contain;
  }

  .qv__info {
    display: flex;
    flex-direction: column;
    gap: 1.5em;
    padding: 3.75em 3em 3em;
  }

  .qv__title {
    font-size: 3.5em;
    letter-spacing: -1.12px;
  }

  .qv__price {
    font-size: 1.75em;
    font-weight: 600;
    line-height: 1.344;
    letter-spacing: -0.56px;
    color: #ffffff;
  }

  .qv__colors {
    display: flex;
    flex-direction: column;
    gap: 0.75em;
    border: none;
  }

  .qv__colors legend {
    float: left;
    margin-bottom: 0.75em;
  }

  .qv__swatches {
    display: flex;
    gap: 0.75em;
    clear: both;
  }

  .qv__swatches :global(label) {
    display: grid;
    place-items: center;
    width: 4.5em;
    height: 4.5em;
    border: 1px solid var(--color-border);
    cursor: pointer;
  }

  .qv__swatches :global(label:has(input:checked)) {
    border-color: var(--color-accent);
  }

  .qv__swatches :global(label:has(input:focus-visible)) {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .qv__swatches :global(input) {
    position: absolute;
    opacity: 0;
  }

  .qv__swatches :global(img) {
    width: 3.25em;
    height: 3.25em;
    object-fit: cover;
  }

  .qv__actions {
    display: flex;
    flex-direction: column;
    gap: 1.25em;
    margin-top: auto;
  }

  .qv__more {
    align-self: center;
    font-size: 1.125em;
    line-height: 1.333;
    letter-spacing: -0.36px;
    color: var(--color-white);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .qv__more:hover {
    color: var(--color-accent);
  }

  @media (max-width: 767px) {
    .qv {
      width: calc(100vw - 2em);
      max-height: calc(100vh - 2em);
    }

    .qv__panel {
      grid-template-columns: 1fr;
    }

    .qv__media {
      min-height: 18em;
    }

    .qv__img {
      height: 16em;
    }

    .qv__info {
      padding: 1.5em 1.25em;
      gap: 1em;
    }

    .qv__title {
      font-size: 2.25em;
    }

    .qv__price {
      font-size: 1.25em;
    }
  }
</style>
