---
import Icon from "./Icon.astro";

interface Props {
  active?: string;
}

const { active } = Astro.props;

const links = [
  { label: "Sofas", href: "/collection/?group=sofas", key: "sofas" },
  { label: "Tables", href: "/collection/?group=tables", key: "tables" },
  { label: "Seating", href: "/collection/?group=seating", key: "seating" },
  { label: "Accessories", href: "/collection/?group=accessories", key: "accessories" },
  { label: "Design services", href: "mailto:support@noire.com?subject=Design%20services", key: "services" },
];
---

<header class="navbar">
  <div class="navbar__inner container container--padded">
    <a class="navbar__logo" href="/" aria-label="NOIRÉ — home">NOIRÉ</a>

    <nav class="navbar__links" aria-label="Main">
      {links.map((l) => (
        <a href={l.href} class:list={["navbar__link", { "is-active": active === l.key }]} aria-current={active === l.key ? "page" : undefined}>
          {l.label}
        </a>
      ))}
    </nav>

    <div class="navbar__icons">
      <a class="navbar__icon navbar__icon--desktop" href="/login/" aria-label="Account">
        <Icon name="user" />
      </a>
      <a class="navbar__icon navbar__icon--desktop" href="/collection/#search" aria-label="Search products">
        <Icon name="search" />
      </a>
      <button class="navbar__icon" type="button" data-cart-open aria-label="Open cart" aria-controls="cart-drawer">
        <Icon name="cart" />
      </button>
      <button class="navbar__icon navbar__menu-btn" type="button" data-menu-toggle aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
        <Icon name="menu" class="menu-open" />
        <Icon name="close" class="menu-close" current />
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden>
    <nav class="mobile-menu__links container container--padded" aria-label="Mobile">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
      <a href="/wishlist/">Wishlist</a>
      <a href="/login/">Account</a>
      <a href="/collection/#search">Search</a>
    </nav>
  </div>
</header>

<style>
  .navbar {
    position: relative;
    z-index: 30;
    padding-top: 2.5em; /* 40px */
  }

  .navbar__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    min-height: 4.4375em; /* 71px */
  }

  .navbar__logo {
    justify-self: start;
    padding: 0.1731em; /* 8px at 46px */
    font-family: var(--font-heading);
    font-size: 2.8892em; /* 46.23px */
    font-weight: 700;
    line-height: 1.19;
    letter-spacing: -0.92px;
    color: var(--color-white);
  }

  .navbar__links {
    display: flex;
    align-items: center;
    gap: 1.875em; /* 30px */
  }

  .navbar__link {
    font-size: 1em;
    font-weight: 500;
    line-height: 1.375;
    letter-spacing: -0.32px;
    color: var(--color-white);
    transition: color var(--transition-fast);
  }

  .navbar__link:hover,
  .navbar__link.is-active {
    color: var(--color-text);
  }

  .navbar__icons {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 1.875em; /* 30px */
  }

  .navbar__icon {
    display: grid;
    place-items: center;
    color: var(--color-white);
    transition: opacity var(--transition-fast);
  }

  .navbar__icon:hover {
    opacity: 0.75;
  }

  .navbar__menu-btn {
    display: none;
  }

  .navbar__menu-btn :global(.menu-close),
  .navbar__menu-btn[aria-expanded="true"] :global(.menu-open) {
    display: none;
  }

  .navbar__menu-btn[aria-expanded="true"] :global(.menu-close) {
    display: block;
  }

  .mobile-menu {
    position: fixed;
    inset: 0;
    top: 0;
    z-index: -1;
    padding-top: 8em;
    background-color: var(--color-bg);
    overflow-y: auto;
  }

  .mobile-menu__links {
    display: flex;
    flex-direction: column;
  }

  .mobile-menu__links a {
    padding: 1em 0;
    border-bottom: 1px solid var(--color-border);
    font-family: var(--font-heading);
    font-size: 2em;
    line-height: 1.2;
    text-transform: uppercase;
    color: var(--color-white);
  }

  @media (max-width: 991px) {
    .navbar {
      padding-top: 1.5em;
    }

    .navbar__inner {
      grid-template-columns: 1fr auto;
      min-height: 3em;
    }

    .navbar__links,
    .navbar__icon--desktop {
      display: none;
    }

    .navbar__logo {
      padding: 0;
      font-size: 1.5em;
    }

    .navbar__icons {
      gap: 1.25em;
    }

    .navbar__icon {
      min-width: 2.75em;
      min-height: 2.75em;
    }

    .navbar__icon :global(svg) {
      width: 1.25em;
      height: 1.25em;
    }

    .navbar__menu-btn {
      display: grid;
    }
  }
</style>
