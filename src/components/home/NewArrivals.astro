---
import ProductCard from "../ProductCard.astro";
import { newArrivals } from "../../data/products";

const [first, second, ...rest] = newArrivals;
---

<section class="arrivals" id="new-arrivals" aria-labelledby="arrivals-title">
  <div class="container container--padded">
    <div class="arrivals__grid" data-carousel>
      <div class="arrivals__intro">
        <div class="arrivals__text">
          <h2 class="title-xl" id="arrivals-title">New ARRIVALS</h2>
          <p class="text-body arrivals__lead">
            Fresh arrivals crafted to bring comfort, elegance, and character into your home — designed to transform everyday living into a more beautiful experience.
          </p>
        </div>
        <a class="btn btn--outline" href="/collection/"><span>Discover the collection</span></a>
      </div>

      <div class="arrivals__cards" data-carousel-track>
        <ProductCard product={first} class="arrivals__card arrivals__card--1" />
        <ProductCard product={second} class="arrivals__card arrivals__card--2" />
        {rest.map((p) => <ProductCard product={p} class="arrivals__card" />)}
      </div>

      <div class="indicator arrivals__indicator" aria-hidden="true"><span data-carousel-thumb></span></div>
    </div>
  </div>
</section>

<style>
  .arrivals {
    margin-top: 12.5em; /* 200px */
  }

  /* Figma: 3 columns of 587px with 20px gaps, rows of 537px with 22px gap; text sits in the top-middle cell */
  .arrivals__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: 33.5625em;
    column-gap: 1.25em;
    row-gap: 1.375em;
  }

  .arrivals__cards {
    display: contents;
  }

  .arrivals__intro {
    grid-column: 2;
    grid-row: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .arrivals__text {
    display: flex;
    flex-direction: column;
    gap: 1.875em; /* 30px */
  }

  .arrivals__lead {
    max-width: 24em; /* 432px at 18px */
  }

  .arrivals__grid :global(.arrivals__card--1) {
    grid-column: 1;
    grid-row: 1;
  }

  .arrivals__grid :global(.arrivals__card--2) {
    grid-column: 3;
    grid-row: 1;
  }

  .arrivals__indicator {
    display: none;
  }

  @media (max-width: 991px) {
    .arrivals {
      margin-top: 6em;
    }

    .arrivals__grid {
      display: flex;
      flex-direction: column;
      gap: 2em;
    }

    .arrivals__intro {
      gap: 2em;
    }

    .arrivals__lead {
      max-width: none;
    }

    .arrivals__cards {
      display: flex;
      gap: 1.125em;
      margin-inline: calc(var(--container-padding) * -1);
      padding-inline: var(--container-padding);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--container-padding);
      scrollbar-width: none;
    }

    .arrivals__cards::-webkit-scrollbar {
      display: none;
    }

    .arrivals__cards > :global(.card) {
      flex: 0 0 min(22em, 70%);
      scroll-snap-align: start;
    }

    .arrivals__indicator {
      display: block;
    }
  }

  @media (max-width: 479px) {
    .arrivals .title-xl {
      font-size: 2.75em; /* 44px */
      font-weight: 500;
      letter-spacing: -0.88px;
    }

    .arrivals__lead {
      font-size: 0.875em;
      line-height: 1.357;
    }

    .arrivals__cards > :global(.card) {
      flex-basis: 14.4375em; /* 231px */
    }
  }
</style>
